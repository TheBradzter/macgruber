<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over a tile (as its foreground) while that tile's sound plays. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#66FFC233" />
    <stroke
        android:width="4dp"
        android:color="@color/mg_white" />
    <corners android:radius="14dp" />
</shape>

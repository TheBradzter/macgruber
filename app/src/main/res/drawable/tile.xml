<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mg_gold">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/mg_fire"
                android:startColor="@color/mg_orange" />
            <stroke
                android:width="2dp"
                android:color="@color/mg_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
